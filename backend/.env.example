# 复制为 backend/.env 后按需修改；.env 已被 .gitignore 忽略，不会提交密钥
DATABASE_URL=sqlite:///./ai_learn.db

# 允许跨域的前端地址，多个用逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MiMo 模型服务（OpenAI 兼容接口）
# 按量付费：https://api.xiaomimimo.com/v1（key 以 sk- 开头）
# Token Plan：https://token-plan-cn.xiaomimimo.com/v1（key 以 tp- 开头，地址以订阅页为准）
# 地址写到 /v1 这一级，代码会自动拼 /chat/completions
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_API_KEY=
MIMO_MODEL=mimo-v2.6-flash
LLM_TIMEOUT=60

# 没有密钥时先打开演示模式，前端三种状态都能跑通
MOCK_LLM=false
